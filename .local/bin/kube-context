#!/usr/bin/env bash

exists() {
	command -v $1 >/dev/null 2>&1
}

if exists mise; then
	eval "$(mise env -s bash 2>/dev/null)"
fi
exists kubectl || exit 0

if [ -d "$HOME/.kube" ]; then
	export KUBECONFIG=$(find "$HOME/.kube" -type f -name "*.config" | paste -sd ":")
fi

current=$(kubectl config view --minify --output 'jsonpath={.current-context}:{..namespace}' 2>/dev/null)
[ -n "$current" ] || exit 0
[[ "$current" == *: ]] && current+="default"
echo "$current"
